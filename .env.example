# hb-ecommerce-lakehouse — environment template
# Owner: Hemanjali Buchireddy
#
# Copy to .env and fill in. .env is gitignored and must NEVER be committed.
#   cp .env.example .env
#
# NOTE: The AWS build credentials do NOT belong in this file.
# They live in ~/.aws/credentials under the [hb] profile so they are never
# read by application code and never end up in a repo. See the Setup section of README.md.

# ---------------------------------------------------------------------------
# 1. AWS build profile  (name only — the actual keys stay in ~/.aws/credentials)
# ---------------------------------------------------------------------------
AWS_PROFILE=hb
AWS_REGION=us-east-1

# ---------------------------------------------------------------------------
# 2. Vercel  (only needed if deploying from a Vercel account that is NOT the
#    one the CLI is already logged into)
# ---------------------------------------------------------------------------
VERCEL_TOKEN=

# ---------------------------------------------------------------------------
# 3. Project naming / config  (not secrets — safe to share)
# ---------------------------------------------------------------------------
BUCKET_PREFIX=hb-ecom-lakehouse
ALERT_EMAIL=
BUDGET_CEILING_USD=
BENCHMARK_TARGET_GB=5

# ---------------------------------------------------------------------------
# 4. Dashboard read-only credentials
#    DO NOT FILL THESE IN. Terraform creates the hb-dashboard-reader IAM user
#    and outputs these values. They get pushed to Vercel's encrypted env store,
#    never to this file and never to git.
# ---------------------------------------------------------------------------
# DASHBOARD_AWS_ACCESS_KEY_ID=<generated by terraform>
# DASHBOARD_AWS_SECRET_ACCESS_KEY=<generated by terraform>

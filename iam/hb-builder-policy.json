{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadOnlyDiscovery",
      "Effect": "Allow",
      "Action": [
        "s3:List*",
        "glue:Get*",
        "glue:List*",
        "glue:BatchGet*",
        "athena:List*",
        "athena:Get*",
        "lambda:List*",
        "lambda:Get*",
        "states:List*",
        "states:Describe*",
        "states:ValidateStateMachineDefinition",
        "firehose:List*",
        "firehose:Describe*",
        "cloudwatch:List*",
        "cloudwatch:Describe*",
        "cloudwatch:Get*",
        "logs:Describe*",
        "logs:Get*",
        "logs:List*",
        "logs:FilterLogEvents",
        "logs:StartQuery",
        "sns:List*",
        "sns:Get*",
        "iam:Get*",
        "iam:List*",
        "budgets:Describe*",
        "budgets:View*",
        "budgets:ListTagsForResource",
        "ce:GetCostAndUsage",
        "ce:GetCostForecast",
        "pricing:GetProducts",
        "sts:GetCallerIdentity",
        "tag:GetResources"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ProjectBucketsFullControl",
      "Effect": "Allow",
      "Action": "s3:*",
      "Resource": [
        "arn:aws:s3:::hb-ecom-lakehouse-*",
        "arn:aws:s3:::hb-ecom-lakehouse-*/*"
      ]
    },
    {
      "Sid": "ProjectGlue",
      "Effect": "Allow",
      "Action": "glue:*",
      "Resource": [
        "arn:aws:glue:us-east-1:904233128322:catalog",
        "arn:aws:glue:us-east-1:904233128322:database/hb_*",
        "arn:aws:glue:us-east-1:904233128322:table/hb_*/*",
        "arn:aws:glue:us-east-1:904233128322:job/hb-*"
      ]
    },
    {
      "Sid": "ProjectCompute",
      "Effect": "Allow",
      "Action": ["athena:*", "lambda:*", "states:*", "firehose:*", "sns:*"],
      "Resource": [
        "arn:aws:athena:us-east-1:904233128322:workgroup/hb-*",
        "arn:aws:lambda:us-east-1:904233128322:function:hb-*",
        "arn:aws:states:us-east-1:904233128322:stateMachine:hb-*",
        "arn:aws:states:us-east-1:904233128322:execution:hb-*:*",
        "arn:aws:firehose:us-east-1:904233128322:deliverystream/hb-*",
        "arn:aws:sns:us-east-1:904233128322:hb-*"
      ]
    },
    {
      "Sid": "ProjectObservability",
      "Effect": "Allow",
      "Action": ["cloudwatch:PutMetricAlarm", "cloudwatch:DeleteAlarms", "cloudwatch:TagResource", "cloudwatch:UntagResource", "cloudwatch:EnableAlarmActions", "cloudwatch:DisableAlarmActions"],
      "Resource": "arn:aws:cloudwatch:us-east-1:904233128322:alarm:hb-*"
    },
    {
      "Sid": "ProjectLogGroups",
      "Effect": "Allow",
      "Action": "logs:*",
      "Resource": [
        "arn:aws:logs:us-east-1:904233128322:log-group:/aws/lambda/hb-*",
        "arn:aws:logs:us-east-1:904233128322:log-group:/aws/lambda/hb-*:*",
        "arn:aws:logs:us-east-1:904233128322:log-group:/aws-glue/*",
        "arn:aws:logs:us-east-1:904233128322:log-group:/aws/vendedlogs/states/hb-*",
        "arn:aws:logs:us-east-1:904233128322:log-group:/aws/vendedlogs/states/hb-*:*",
        "arn:aws:logs:us-east-1:904233128322:log-group:/aws/kinesisfirehose/hb-*",
        "arn:aws:logs:us-east-1:904233128322:log-group:/aws/kinesisfirehose/hb-*:*"
      ]
    },
    {
      "Sid": "StateMachineLoggingNeedsWildcard",
      "Effect": "Allow",
      "Action": ["logs:CreateLogDelivery", "logs:GetLogDelivery", "logs:UpdateLogDelivery", "logs:DeleteLogDelivery", "logs:ListLogDeliveries", "logs:PutResourcePolicy", "logs:DescribeResourcePolicies"],
      "Resource": "*"
    },
    {
      "Sid": "ProjectRolesOnly",
      "Effect": "Allow",
      "Action": ["iam:CreateRole", "iam:DeleteRole", "iam:UpdateRole", "iam:AttachRolePolicy", "iam:DetachRolePolicy", "iam:PutRolePolicy", "iam:DeleteRolePolicy", "iam:PassRole", "iam:TagRole", "iam:UntagRole", "iam:UpdateAssumeRolePolicy"],
      "Resource": "arn:aws:iam::904233128322:role/hb-*"
    },
    {
      "Sid": "ProjectPoliciesAndDashboardUserOnly",
      "Effect": "Allow",
      "Action": ["iam:CreatePolicy", "iam:DeletePolicy", "iam:CreatePolicyVersion", "iam:DeletePolicyVersion", "iam:SetDefaultPolicyVersion", "iam:CreateUser", "iam:DeleteUser", "iam:TagUser", "iam:UntagUser", "iam:PutUserPolicy", "iam:DeleteUserPolicy", "iam:AttachUserPolicy", "iam:DetachUserPolicy", "iam:CreateAccessKey", "iam:DeleteAccessKey"],
      "Resource": [
        "arn:aws:iam::904233128322:policy/hb-*",
        "arn:aws:iam::904233128322:user/hb-dashboard-reader"
      ]
    },
    {
      "Sid": "Budgets",
      "Effect": "Allow",
      "Action": ["budgets:ModifyBudget", "budgets:CreateBudget", "budgets:UpdateBudget", "budgets:DeleteBudget", "budgets:TagResource", "budgets:UntagResource"],
      "Resource": "arn:aws:budgets::904233128322:budget/*"
    }
  ]
}
